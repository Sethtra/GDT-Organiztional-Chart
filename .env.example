VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Used only by the local deployment script. Never expose a service-role key to
# Vite or commit it to an environment file.
GDT_SUPABASE_PROJECT_REF=your-project-ref

# Keep false until the HR/RBAC migrations have been applied and verified in
# this Supabase environment.
VITE_HR_FEATURES_ENABLED=false

# Enable only after chart_versions INSERT/DELETE RLS has been tested for chart
# owners and accepted editors.
VITE_CHART_VERSION_WRITES_ENABLED=false
